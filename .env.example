# ---------- BuyWise AI : copy to server/.env ----------

# Server
PORT=5050
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database ------------------------------------------------------------
# Leave MONGO_URI empty to run on the built-in file-backed store
# (zero setup - perfect for a demo). Set it to use real MongoDB Atlas.
MONGO_URI=
MONGO_DB_NAME=buywise

# AI ------------------------------------------------------------------
# Leave all keys empty -> BuyWise runs its built-in rule-based
# intent engine, so the whole agent still works offline.
# Set ONE of these to switch on a real LLM.
AI_PROVIDER=auto            # auto | anthropic | gemini | openai | rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Payment (Razorpay sandbox) ------------------------------------------
# Leave empty -> demo payment simulator is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
